# 🔒 毛毛AI项目环境变量配置示例
# 重要：复制此文件为.env，并填写真实的API密钥
# 注意：.env文件已在.gitignore中，不会提交到GitHub

# ========================
# API密钥配置（需要填写真实的）
# ========================

# GitHub配置（如果需要）
GITHUB_TOKEN=your_github_token_here

# 数据API配置
TAVILY_API_KEY=your_tavily_api_key_here
QVERIS_API_KEY=your_qveris_api_key_here

# AI服务配置
OPENAI_API_KEY=sk-your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ========================
# 应用配置（可按需修改）
# ========================

# 股票监控配置
MONITOR_INTERVAL=300
ALERT_THRESHOLD=0.05
WATCHLIST=000001.SZ,600519.SH,300750.SZ

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/maomao.log

# 缓存配置
CACHE_ENABLED=true
CACHE_TTL=300

# 性能配置
MAX_WORKERS=10
REQUEST_TIMEOUT=30

# ========================
# 开发配置（通常不需要修改）
# ========================

# 调试模式
DEBUG=false
TESTING=false

# 数据库配置（如果有）
# DATABASE_URL=postgresql://user:password@localhost/dbname
# REDIS_URL=redis://localhost:6379
